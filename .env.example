# ============================================================
# PulseGuard AI — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# Anthropic
ANTHROPIC_API_KEY=                     # Your Anthropic API key

# LangSmith (observability — required for traces)
LANGCHAIN_API_KEY=                     # LangSmith API key
LANGCHAIN_PROJECT=pulseguard-ai        # LangSmith project name
LANGCHAIN_TRACING_V2=true

# X (Twitter) API — Basic tier ($200/mo)
X_BEARER_TOKEN=                        # OAuth 2.0 Bearer Token (app-only, read)
X_API_TIER=basic                       # "basic" (polling) | "pro" (streaming, $5k/mo)
X_MONTHLY_CAP=15000                    # Monthly read cap for Basic tier
X_POLL_INTERVAL_SECONDS=300            # Poll every 5 minutes

# Reddit — read-only OAuth (free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PulseGuard/1.0

# Slack notifications
SLACK_WEBHOOK_URL=                     # Incoming webhook URL for escalation alerts

# Email notifications (choose SMTP or SendGrid)
NOTIFICATION_EMAIL=                    # Recipient address for escalation briefs
SENDGRID_API_KEY=                      # SendGrid API key (leave blank to use SMTP)
SMTP_HOST=                             # SMTP server hostname
SMTP_PORT=587                          # SMTP port (587 for STARTTLS)
SMTP_USER=
SMTP_PASSWORD=

# Enterprise integrations — each is independently optional; unset = skipped.
# These let escalations land directly in a CX team's existing tools instead
# of only a Slack/email alert.
WEBHOOK_URL=                            # Generic outbound webhook (Zapier/Make/n8n/ServiceNow/custom)
WEBHOOK_SECRET=                         # Optional — signs the payload as X-PulseGuard-Signature (HMAC-SHA256)
TEAMS_WEBHOOK_URL=                      # A Teams channel Workflow's webhook URL (NOT a legacy connector URL — those were retired in 2026)
ZENDESK_SUBDOMAIN=                      # e.g. "acme" for acme.zendesk.com
ZENDESK_EMAIL=                          # Agent email used with the API token
ZENDESK_API_TOKEN=
FRESHDESK_DOMAIN=                       # e.g. "acme" for acme.freshdesk.com
FRESHDESK_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# FastAPI Gateway
PULSEGUARD_API_KEY=                    # Bearer token for gateway API auth
TRUSTED_PROXY_IPS=                     # Comma-separated ingress IP(s); CF-Connecting-IP/X-Forwarded-For
                                        # are only trusted for rate limiting from these peers

# Carrier monitoring (comma-separated)
MONITORED_CARRIERS=verizon,tmobile,att

# Runtime
ENVIRONMENT=development                # "development" | "production"
AUDIT_LOG_PATH=logs/audit.jsonl
ENABLE_ADAPTER_POLLING=true             # Set to false to disable live feed polling (e.g. while out of LLM credits)
