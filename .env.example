# ============================================================
# PulseGuard AI — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# Anthropic
ANTHROPIC_API_KEY=                     # Your Anthropic API key

# LangSmith (observability — required for traces)
LANGCHAIN_API_KEY=                     # LangSmith API key
LANGCHAIN_PROJECT=pulseguard-ai        # LangSmith project name
LANGCHAIN_TRACING_V2=true

# X (Twitter) API — Basic tier ($200/mo)
X_BEARER_TOKEN=                        # OAuth 2.0 Bearer Token (app-only, read)
X_API_TIER=basic                       # "basic" (polling) | "pro" (streaming, $5k/mo)
X_MONTHLY_CAP=15000                    # Monthly read cap for Basic tier
X_POLL_INTERVAL_SECONDS=300            # Poll every 5 minutes

# Reddit — read-only OAuth (free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PulseGuard/1.0

# Trustpilot — no auth required; rate limit settings
TRUSTPILOT_POLL_INTERVAL_SECONDS=86400
TRUSTPILOT_REQUEST_DELAY_SECONDS=1

# SerpAPI — used for Quora search (Quora has no public API)
SERPAPI_API_KEY=
QUORA_POLL_INTERVAL_SECONDS=86400

# Slack notifications
SLACK_WEBHOOK_URL=                     # Incoming webhook URL for escalation alerts

# Email notifications (choose SMTP or SendGrid)
NOTIFICATION_EMAIL=                    # Recipient address for escalation briefs
SENDGRID_API_KEY=                      # SendGrid API key (leave blank to use SMTP)
SMTP_HOST=                             # SMTP server hostname
SMTP_PORT=587                          # SMTP port (587 for STARTTLS)
SMTP_USER=
SMTP_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# FastAPI Gateway
PULSEGUARD_API_KEY=                    # Bearer token for gateway API auth

# Carrier monitoring (comma-separated)
MONITORED_CARRIERS=verizon,tmobile,att

# Runtime
ENVIRONMENT=development                # "development" | "production"
AUDIT_LOG_PATH=logs/audit.jsonl
ENABLE_ADAPTER_POLLING=true             # Set to false to disable live feed polling (e.g. while out of LLM credits)
