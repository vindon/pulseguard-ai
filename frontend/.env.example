# Base URL of the PulseGuard FastAPI gateway (server-side only — never
# exposed to the browser). Local dev default matches docker-compose.yml.
PULSEGUARD_API_URL=http://localhost:8000

# Must match PULSEGUARD_API_KEY in the backend's .env — sent as the
# X-API-Key header on every proxied request. Server-side only.
PULSEGUARD_API_KEY=
